# Copy to .env and fill in
PUBLIC_BASE_URL=https://your-public-url.example.com

# Key for the Android apps (phone API + dashboard). >= 24 chars. Generate:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
PHONE_AGENT_KEY=change-me-to-a-long-random-string

# Twilio mode (optional if you only use the Android app)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+1XXXXXXXXXX
VALIDATE_TWILIO=1
DELETE_RECORDINGS=1

AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

OWNER_NAME=Kathir
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional voice overrides
# VOICE_TA=ta-LK-KumarNeural
# VOICE_SI=si-LK-SameeraNeural
# VOICE_EN=en-IN-PrabhatNeural
